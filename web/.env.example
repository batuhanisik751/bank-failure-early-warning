# Copy to web/.env.local for a standalone checkout. In this repository the git-ignored
# root .env is read by next.config.ts, so nothing needs to be duplicated here.
# Postgres connection string. Neon: the pooled URL with sslmode=verify-full.
DATABASE_URL=postgresql://user:password@localhost:5433/bankcanary
# Bearer token for POST /api/revalidate (expires the "data" cache tag).
REVALIDATE_SECRET=change-me
# Public origin used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
