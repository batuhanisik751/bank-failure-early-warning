# Copy to .env and fill in. Never commit .env.
# FDIC BankFind API works without a key today; set one only if the API starts requiring it.
FDIC_API_KEY=
# FRED (Federal Reserve Economic Data) API key, Prototype 2
FRED_API_KEY=
# Postgres connection string for the publish job and the web app (Prototype 3).
# Local development (docker compose up -d): postgresql://bankcanary:bankcanary@localhost:5433/bankcanary
# Production: the Neon pooled connection string, set only in GitHub and Vercel secrets.
DATABASE_URL=
# Secret for the on-demand cache revalidation route of the web app (32+ random characters)
REVALIDATE_SECRET=
